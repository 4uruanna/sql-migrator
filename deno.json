{
  "name": "@4uruanna/sql-migrator",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "exports": "./source/cli.ts",
  "tasks": {
    "migrate": "cd test/ && deno run --allow-env --env-file --allow-net --allow-read ../source/cli.ts migrate",
    "rollback": "cd test/ && deno run --allow-env --env-file --allow-net --allow-read ../source/cli.ts rollback",
    "status": "cd test/ && deno run --allow-env --env-file --allow-net --allow-read ../source/cli.ts status",
    "help": "cd test/ && deno run ../source/cli.ts help"
  },
  "imports": {
    "@4uruanna/sql-connector": "jsr:@4uruanna/sql-connector@^1.1.0",
    "@4uruanna/sql-query-builder": "jsr:@4uruanna/sql-query-builder@^1.0.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.5",
    "zod": "npm:zod@^4.4.3"
  }
}
